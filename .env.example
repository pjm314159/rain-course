# ============================================================
# rain-course 配置模板
#
# 本地开发：复制为 backend/.env 或仓库根 .env 后按需修改
# Docker 部署：cp .env.example .env（仓库根），compose 会用它同时完成
#   - 后端容器环境变量注入（docker-compose.yml 的 env_file）
#   - 前端构建期变量注入（docker-compose.yml 的 build.args）
# .env 已被 gitignore，不会入库
# ============================================================

# --- 服务 ---
# 监听端口
PORT=3000

# 签名 cookie 的 HMAC 密钥（务必改成一段足够长的随机字符串）
# 生成示例：openssl rand -hex 32
SERVER_SECRET=dev-secret-please-change-me

# 本站会话有效期（秒）；默认 1209600 = 14 天，对齐雨课堂 sessionid
COOKIE_TTL_SECS=1209600

# --- 雨课堂 ---
# 服务端基地址（对应 course_helper 的 serverBaseUrlMap）
YK_BASE_URL=https://www.yuketang.cn

# 扫码内容校验的域名白名单（逗号分隔；非白名单内容一律拒绝且不发起出站请求）
YK_ALLOWED_HOSTS=www.yuketang.cn,pro.yuketang.cn,changjiang.yuketang.cn,huanghe.yuketang.cn

# --- 腾讯验证码 ---
# 复用雨课堂的 CaptchaAppId（实测不限域名）
YK_CAPTCHA_APP_ID=2091064951

# --- 微信公众号（M5 微信内扫码签到；不填则微信内自动降级为相机扫码）---
# 需已认证服务号/订阅号的 JS 安全域名配置，且与部署域名一致
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- 日志 ---
# tracing EnvFilter，如 info / debug / rain_course_backend=debug,tower_http=info
LOG_DIR=logs
# 日志级别
RUST_LOG=info

# --- WS 房间资源上限（docs/DESIGN.md §6，防 OOM，全部可调）---
# 全局房间总数 / 每用户建房数 / 单房间人数
WS_MAX_ROOMS_TOTAL=100
WS_MAX_ROOMS_PER_USER=5
WS_MAX_MEMBERS_PER_ROOM=50
# 单条消息字节数 / 每分钟消息条数 / 每房间历史消息条数（FIFO 淘汰最旧）
WS_MAX_MSG_BYTES=2048
WS_MSGS_PER_MIN=30
WS_MAX_MSGS_PER_ROOM=100
# 二维码消息有效期上限（秒，硬性 ≤ 3600，配置只允许调小）
WS_QR_TTL_MAX_SECS=3600
# 房间无消息自动删除（秒，含永久房间）
WS_ROOM_INACTIVITY_TTL_SECS=1209600
# 全局连接数 / 心跳周期与判死秒数 / lobby 空闲回收秒数 / 房间默认生命周期秒数 / 密码错误限速（次/分）
WS_MAX_CONNECTIONS=500
WS_HEARTBEAT_INTERVAL_SECS=30
WS_HEARTBEAT_DEAD_AFTER_SECS=60
WS_LOBBY_IDLE_SECS=600
WS_ROOM_DEFAULT_LIFETIME_SECS=14400
WS_PW_ATTEMPTS_PER_MIN=5

# --- 前端构建期变量（仅 Docker 部署需要；VITE_ 前缀会打进产物，不要放密钥）---
# 这些值由 docker-compose.yml 的 build.args 传给前端镜像；
# 裸机/本地前端开发请改 frontend/.env.example（组件说明见该文件）
# 同源部署（nginx 反代 /api 与 /ws）留空即可
VITE_API_BASE_URL=
# 腾讯验证码 AppId 兜底值（正常优先使用后端 /api/health 下发的动态值）
VITE_CAPTCHA_APP_ID=2091064951
# ICP 备案号（可选）：填写后登录页底部展示并链接工信部，留空则完全不渲染；
# 改后需重建前端镜像：docker compose up -d --build frontend
VITE_ICP_BEIAN=
# 微信 JS-SDK 调试开关：true 时 wx.config 以 alert 输出签名校验细节，仅真机排查用
VITE_WX_DEBUG=