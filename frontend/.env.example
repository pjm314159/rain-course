# ============================================================
# rain-course 前端配置模板（Vite 环境变量）
# 复制为 .env 或 .env.local 修改；两者均已 gitignore
# 注意：VITE_ 前缀变量会打进构建产物，不要放任何密钥
# ============================================================

# 后端 API 基地址：同源部署（nginx 反代 /api 与 /ws）留空即可；
# 前后端分离部署时填后端完整地址，如 https://api.example.com
VITE_API_BASE_URL=

# 腾讯验证码 AppId 兜底值（正常优先使用后端 /api/health 下发的动态值）
VITE_CAPTCHA_APP_ID=2091064951

# 微信 JS-SDK 调试开关：true 时 wx.config 以 alert 弹窗输出签名校验细节
# 仅用于真机排查 invalid signature，上线务必留空
VITE_WX_DEBUG=
